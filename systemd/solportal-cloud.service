[Unit]
Description=Solportalen outgoing HTTPS portal agent
After=network-online.target mariadb.service
Wants=network-online.target
[Service]
Type=simple
User=solportal
Group=solportal-app
WorkingDirectory=/opt/solportalen
ExecStart=/usr/bin/php /opt/solportalen/bin/solportal worker:cloud
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solportalen/var
UMask=0077
[Install]
WantedBy=multi-user.target
