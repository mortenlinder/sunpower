APP_NAME=Solportalen
APP_TAGLINE="Lokal energi. Fuld kontrol."
APP_ENV=production
APP_KEY=
APP_URL=http://solportal.local
APP_TIMEZONE=Europe/Copenhagen
DB_DSN=mysql:host=127.0.0.1;dbname=solportalen;charset=utf8mb4
DB_USER=solportal
DB_PASSWORD=
DEVICE_MODE=growatt
WRITES_ENABLED=false
AUTOMATION_MODE=shadow
PRICE_AREA=DK2
PRICE_ENDPOINT=https://api.energidataservice.dk/dataset/DayAheadPrices
SERIAL_DEVICE=/dev/serial/by-id/CHANGE-ME
SERIAL_BAUD=9600
SERIAL_SLAVE_ID=1
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_TOPIC=watts/CHANGE-ME/measurement
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
